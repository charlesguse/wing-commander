# spec-kit machine-local state (each environment resolves its own active feature)
.specify/feature.json

# Claude Code local settings/credentials — never commit agent-local state
.claude/settings.local.json
.claude/.credentials.json

# Byte-cache from the verifier scripts importing wc_shell_harness. Generated
# on every local gate run; only ever debris in a commit.
__pycache__/
*.pyc
.claude/worktrees/

# board-loop.yml's own trusted-copy checkout (specs/086-trusted-composite-resolution):
# a checkout of this repository at github.sha, so no git add invocation --
# scripted or agent-typed -- can ever stage it into a board item's branch.
.wc-pristine-repo/
