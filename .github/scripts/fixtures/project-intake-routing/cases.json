    {"name": "subfolder slug within budget", "project": "ideas/alpha", "budget": "33", "branch": "ideas/alpha/001-login", "expect": "pass", "spec_dir": "ideas/alpha/specs/001-login"},
    {"name": "subfolder slug exactly at budget", "project": "ideas/alpha", "budget": "33", "branch": "ideas/alpha/001-abcdefghijklmnopqrstuvwxyz123", "expect": "pass", "spec_dir": "ideas/alpha/specs/001-abcdefghijklmnopqrstuvwxyz123"},
    {"name": "subfolder slug one over budget", "project": "ideas/alpha", "budget": "33", "branch": "ideas/alpha/001-abcdefghijklmnopqrstuvwxyz1234", "expect": "fail", "names": ["33 characters", "ideas/alpha"]}
  ]
