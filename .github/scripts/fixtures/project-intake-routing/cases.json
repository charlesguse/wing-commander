    {"name": "routing on, root issue already specified (no routing label)", "labels": ["spec-request", "spec:001-login"], "existing": "spec:001-login"},
    {"name": "routing on, first run", "labels": ["node:ideas/alpha", "spec-request"], "existing": ""},
    {"name": "routing on, another intake holds the claim", "labels": ["node:ideas/alpha", "spec-intake-claimed"], "existing": "spec-intake-claimed"}
  ],
  "label_first_hook": [
