    {"name": "three routing labels refuse", "labels": ["node:a", "node:b", "node:c"], "expect": "fail", "names": ["3 routing labels"]},
    {"name": "a routing label breaking the grammar refuses", "labels": ["node:Ideas/Alpha"], "expect": "fail", "names": ["Ideas/Alpha"]},
    {"name": "a bare routing label refuses rather than routing to the root", "labels": ["node:"], "expect": "fail", "names": ["names no project folder"]},
    {"name": "a routing label with a leading slash refuses", "labels": ["node:/ideas/alpha"], "expect": "fail", "names": ["/ideas/alpha"]},
    {"name": "a routing label with a leading double slash refuses", "labels": ["node://ideas"], "expect": "fail", "names": ["//ideas"]}
  ],
  "folder": [
    {"name": "complete Spec Kit project", "project": "ideas/alpha", "layout": "speckit", "expect": "pass"},
    {"name": "missing folder", "project": "ideas/alpha", "layout": "none", "expect": "fail", "names": ["ideas/alpha", "not a directory"]},
    {"name": "folder that is not a Spec Kit project", "project": "ideas/alpha", "layout": "plain", "expect": "fail", "names": ["ideas/alpha", ".specify"]},
    {"name": "folder that lost its constitution", "project": "ideas/alpha", "layout": "no-constitution", "expect": "fail", "names": ["ideas/alpha", "constitution"]}
  ],
  "rerun": [
