    {"name": "subfolder slug exactly at budget", "project": "ideas/alpha", "num": "001", "ref": "spec-draft/ideas/alpha/001-abcdefghijklmnopqrstuvwxyz123", "commit": ["ideas/alpha/specs/001-abcdefghijklmnopqrstuvwxyz123/spec.md"], "expect": "pass", "label": "spec:ideas/alpha/001-abcdefghijklmnopqrstuvwxyz123"},
    {"name": "subfolder slug one over budget", "project": "ideas/alpha", "num": "001", "ref": "spec-draft/ideas/alpha/001-abcdefghijklmnopqrstuvwxyz1234", "commit": ["ideas/alpha/specs/001-abcdefghijklmnopqrstuvwxyz1234/spec.md"], "expect": "fail", "names": ["at most 33"]},
    {"name": "branch without the allocated number", "project": "ideas/alpha", "num": "001", "ref": "spec-draft/ideas/alpha/002-login", "commit": ["ideas/alpha/specs/002-login/spec.md"], "expect": "fail", "names": ["001"]},
