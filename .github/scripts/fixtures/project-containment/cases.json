{
  "tool_args": {
    "nested_project": {
      "project": "a/b",
      "denied": [".claude/**", ".git/**", "a/.claude/**", "a/b/.claude/**", "a/b/**/.claude/**"]
    },
    "single_segment_project": {
      "project": "ideas",
      "denied": [".claude/**", ".git/**", "ideas/.claude/**", "ideas/**/.claude/**"],
      "not_denied": ["Edit(ideas/**)"]
    },
    "denies_hold_with_no_write_paths_overridden": {
      "project": "a/b",
      "no_write_paths": "docs/",
      "disallowed_override": "",
      "denied": ["docs/**", "a/.claude/**", "a/b/**/.claude/**", ".wing-commander-pipeline/**"],
      "denied_tools": ["Bash(git push --no-verify:*)"]
    },
    "routed_intake_denied_every_push": {
      "project": "ideas/alpha",
      "default_allowed": "Read,Edit,Bash(git commit:*),Bash(git push:*)",
      "extra_allowed": "Bash(git push:*)",
      "project_deny_tools": "Bash(git push:*)",
      "denied_tools": ["Bash(git push:*)"],
      "not_stated": ["git push"]
    },
    "project_deny_tools_ignored_at_the_root": {
      "project": "",
      "default_allowed": "Read,Bash(git push:*)",
      "project_deny_tools": "Bash(git push:*)",
      "allowed": ["Read", "Bash(git push:*)"],
      "not_denied": ["git push"]
    },
    "raw_api_denied_for_a_project_even_when_extra_allowed": {
      "project": "ideas/alpha",
      "default_allowed": "Read,Edit,Bash(gh api:*),Bash(gh pr view:*)",
      "extra_allowed": "Bash(gh api:*)",
      "denied_tools": ["Bash(gh api:*)"],
      "not_stated": ["gh api"]
    },
    "raw_api_untouched_at_the_root": {
      "project": "",
      "default_allowed": "Read,Edit,Bash(gh api:*)",
      "allowed": ["Read", "Edit", "Bash(gh api:*)"],
      "not_denied": ["gh api"]
    },
    "hook_bypass_denied_for_a_project": {
      "project": "ideas/alpha",
      "default_allowed": "Read,Edit,Bash(git push:*)",
      "denied_tools": ["Bash(git push --no-verify:*)"],
      "not_denied": ["git push -n"]
    },
    "project_spec_kit_script_grants": {
      "project": "ideas/alpha",
      "default_allowed": "Read,Bash(.specify/scripts/bash/check-prerequisites.sh:*),Bash(bash .specify/scripts/bash/setup-plan.sh:*),Bash(git status:*)",
      "allowed": ["Read", "Bash(.specify/scripts/bash/check-prerequisites.sh:*)", "Bash(bash .specify/scripts/bash/setup-plan.sh:*)", "Bash(git status:*)",
                  "Bash(ideas/alpha/.specify/scripts/bash/check-prerequisites.sh:*)", "Bash(bash ideas/alpha/.specify/scripts/bash/setup-plan.sh:*)"],
      "denied": [".claude/**", "ideas/alpha/.claude/**"]
    },
    "root_spec_kit_script_grants_unchanged": {
      "project": "",
      "default_allowed": "Read,Bash(.specify/scripts/bash/check-prerequisites.sh:*),Bash(bash .specify/scripts/bash/setup-plan.sh:*)",
      "allowed": ["Read", "Bash(.specify/scripts/bash/check-prerequisites.sh:*)", "Bash(bash .specify/scripts/bash/setup-plan.sh:*)"],
      "not_denied": [".claude/", "--no-verify"]
    }
  },
  "containment": {
    "inside_edit": {
      "project": "a/b",
      "base_files": ["a/b/specs/001-x/spec.md", "README.md"],
      "modify": ["a/b/specs/001-x/spec.md"],
      "expect": "pass"
    },
    "inside_new_file": {
      "project": "a/b",
      "base_files": ["a/b/x.md"],
      "create": ["a/b/src/new.py"],
      "expect": "pass"
    },
    "nested_folder_move_inside": {
      "project": "a",
      "base_files": ["a/b/README.md", "a/b/specs/001-x/spec.md"],
      "move": [["a/b", "a/c"]],
      "commit": true,
      "expect": "pass"
    },
    "child_index_readme_inside": {
      "project": "a",
      "base_files": ["a/README.md", "a/b/x.md"],
      "modify": ["a/README.md"],
      "expect": "pass"
    },
    "uncommitted_outside": {
      "project": "a/b",
      "base_files": ["a/b/x.md", "README.md"],
      "modify": ["README.md"],
      "expect": "fail",
      "names": ["README.md"]
    },
    "committed_outside": {
      "project": "a/b",
      "base_files": ["a/b/x.md", "a/other.md"],
      "modify": ["a/other.md"],
      "commit": true,
      "expect": "fail",
      "names": ["a/other.md"]
    },
    "untracked_outside": {
      "project": "a/b",
      "base_files": ["a/b/x.md"],
      "create": ["stray.txt"],
      "expect": "fail",
      "names": ["stray.txt"]
    },
    "sibling_prefix_is_outside": {
      "project": "a/b",
      "base_files": ["a/b/x.md"],
      "create": ["a/bc/y.md"],
      "expect": "fail",
      "names": ["a/bc/y.md"]
    },
    "root_lifecycle_skipped": {
      "project": "",
      "base_files": ["README.md"],
      "modify": ["README.md"],
      "expect": "pass"
    },
    "untracked_trusted_checkout_ignored": {
      "project": "a/b",
      "base_files": ["a/b/x.md"],
      "nested_repo": [".wing-commander-pipeline"],
      "modify": ["a/b/x.md"],
      "expect": "pass"
    },
    "nested_trusted_checkout_name_is_outside": {
      "project": "a/b",
      "base_files": ["a/b/x.md"],
      "nested_repo": ["a/.wing-commander-pipeline"],
      "expect": "fail",
      "names": ["a/.wing-commander-pipeline"]
    },
    "committed_move_into_project": {
      "project": "a/b",
      "base_files": ["a/b/x.md", "outside.md"],
      "move": [["outside.md", "a/b/outside.md"]],
      "commit": true,
      "expect": "fail",
      "names": ["outside.md"]
    },
    "staged_move_into_project": {
      "project": "a/b",
      "base_files": ["a/b/x.md", "outside.md"],
      "move": [["outside.md", "a/b/outside.md"]],
      "expect": "fail",
      "names": ["outside.md"]
    },
    "earlier_pushed_violation_caught_after_restart": {
      "project": "a/b",
      "base_files": ["a/b/x.md", "README.md"],
      "earlier_run": ["README.md"],
      "modify": ["a/b/x.md"],
      "expect": "fail",
      "names": ["README.md"]
    },
    "earlier_run_inside_passes_after_restart": {
      "project": "a/b",
      "base_files": ["a/b/x.md", "README.md"],
      "earlier_run": ["a/b/y.md"],
      "modify": ["a/b/x.md"],
      "expect": "pass"
    },
    "unresolvable_default_branch_fails_closed": {
      "project": "a/b",
      "base_files": ["a/b/x.md"],
      "default_branch": "no-such-branch",
      "modify": ["a/b/x.md"],
      "expect": "fail",
      "names": ["merge base"]
    },
    "delete_outside_with_near_identical_add_inside": {
      "project": "a/b",
      "base_files": ["a/b/x.md", "docs/guide.md"],
      "copy": [["docs/guide.md", "a/b/guide.md"]],
      "remove": ["docs/guide.md"],
      "commit": true,
      "expect": "fail",
      "names": ["docs/guide.md"]
    },
    "forged_tracking_ref_still_diffs_from_remote_tip": {
      "project": "a/b",
      "base_files": ["a/b/x.md", "README.md"],
      "earlier_run": ["README.md"],
      "forged_tracking_ref": true,
      "modify": ["a/b/x.md"],
      "expect": "fail",
      "names": ["README.md"]
    },
    "merged_remote_branch_outside": {
      "project": "a/b",
      "base_files": ["a/b/x.md", "README.md"],
      "remote_branch": ["README.md"],
      "modify": ["a/b/x.md"],
      "expect": "fail",
      "names": ["README.md"]
    },
    "default_branch_resolved_from_remote_when_empty": {
      "project": "a/b",
      "base_files": ["a/b/x.md", "README.md"],
      "earlier_run": ["README.md"],
      "default_branch": "",
      "modify": ["a/b/x.md"],
      "expect": "fail",
      "names": ["README.md"]
    },
    "default_branch_resolved_from_remote_inside_passes": {
      "project": "a/b",
      "base_files": ["a/b/x.md", "README.md"],
      "default_branch": "",
      "modify": ["a/b/x.md"],
      "expect": "pass"
    },
    "no_remote_fails_closed": {
      "project": "a/b",
      "base_files": ["a/b/x.md"],
      "no_remote": true,
      "modify": ["a/b/x.md"],
      "expect": "fail",
      "names": ["merge base"]
    }
  },
  "pre_push": {
