{
  "now": "2026-11-22T12:00:00Z",
  "base_entry": {
    "workflows": [{"file": "a.yml", "cadence": "schedule"}],
    "kill_switch": null,
    "requires_var": null,
    "signal": null
  },
  "cases": [
    {"label": "healthy: recent successes", "runs": {"a.yml": [[2, "success"], [26, "success"]]}, "expect": "healthy"},
    {"label": "idle: event workflow with no runs", "entry": {"workflows": [{"file": "a.yml", "cadence": "event"}]}, "runs": {"a.yml": []}, "expect": "idle"},
    {"label": "idle: only skipped runs, event", "entry": {"workflows": [{"file": "a.yml", "cadence": "event"}]}, "runs": {"a.yml": [[5, "skipped"]]}, "expect": "idle"},
    {"label": "skipped and cancelled count toward cadence only", "runs": {"a.yml": [[3, "skipped"], [10, "cancelled"]]}, "expect": "idle"},
    {"label": "quiet: all runs green, signal 20 days old", "entry": {"signal": {"kind": "release"}}, "signal_days_ago": 20, "runs": {"a.yml": [[2, "success"]]}, "expect": "quiet"},
    {"label": "quiet: all runs green, signal never seen", "entry": {"signal": {"kind": "release"}}, "signal_days_ago": null, "runs": {"a.yml": [[2, "success"]]}, "expect": "quiet"},
    {"label": "healthy: signal seen 3 days ago", "entry": {"signal": {"kind": "release"}}, "signal_days_ago": 3, "runs": {"a.yml": [[2, "success"]]}, "expect": "healthy"},
    {"label": "quiet beats idle", "entry": {"signal": {"kind": "release"}, "workflows": [{"file": "a.yml", "cadence": "event"}]}, "signal_days_ago": null, "runs": {"a.yml": []}, "expect": "quiet"},
    {"label": "custom quiet_days 3 with a 5-day signal", "entry": {"signal": {"kind": "release"}, "quiet_days": 3}, "signal_days_ago": 5, "runs": {"a.yml": [[2, "success"]]}, "expect": "quiet"},
    {"label": "custom quiet_days 30 with a 20-day signal", "entry": {"signal": {"kind": "release"}, "quiet_days": 30}, "signal_days_ago": 20, "runs": {"a.yml": [[2, "success"]]}, "expect": "healthy"},
    {"label": "not running: last run 100h ago on a daily schedule", "runs": {"a.yml": [[100, "success"]]}, "expect": "not running"},
    {"label": "not running: scheduled and never ran", "runs": {"a.yml": []}, "expect": "not running"},
    {"label": "failing: three failures", "runs": {"a.yml": [[2, "failure"], [26, "failure"], [50, "failure"]]}, "expect": "failing"},
    {"label": "failing: one failure and nothing else", "runs": {"a.yml": [[2, "failure"]]}, "expect": "failing"},
    {"label": "not failing: a success between failures", "runs": {"a.yml": [[2, "failure"], [26, "success"], [50, "failure"]]}, "expect": "healthy"},
    {"label": "failing across a cancelled run", "runs": {"a.yml": [[2, "failure"], [10, "cancelled"], [26, "failure"]]}, "expect": "failing"},
    {"label": "failing beats not running", "runs": {"a.yml": [[100, "failure"], [130, "failure"]]}, "expect": "failing"},
    {"label": "paused with green runs", "entry": {"kill_switch": "WING_COMMANDER_X_PAUSED"}, "ctx": {"switches": {"WING_COMMANDER_X_PAUSED": true}}, "runs": {"a.yml": [[2, "success"]]}, "expect": "paused"},
    {"label": "switch off is not paused", "entry": {"kill_switch": "WING_COMMANDER_X_PAUSED"}, "ctx": {"switches": {"WING_COMMANDER_X_PAUSED": false}}, "runs": {"a.yml": [[2, "success"]]}, "expect": "healthy"},
    {"label": "not configured: variable unset and runs skipped", "entry": {"requires_var": "WING_COMMANDER_Y"}, "ctx": {"vars_set": {"WING_COMMANDER_Y": false}}, "runs": {"a.yml": [[3, "skipped"]]}, "expect": "not configured"},
    {"label": "variable set and runs skipped is not 'not configured'", "entry": {"requires_var": "WING_COMMANDER_Y"}, "ctx": {"vars_set": {"WING_COMMANDER_Y": true}}, "runs": {"a.yml": [[3, "skipped"]]}, "expect": "idle"},
    {"label": "unreadable: run history", "runs": {"a.yml": {"unreadable": "HTTP 500"}}, "expect": "unreadable"},
    {"label": "unreadable: switch", "entry": {"kill_switch": "WING_COMMANDER_X_PAUSED"}, "ctx": {"switches": {"WING_COMMANDER_X_PAUSED": "unreadable"}}, "runs": {"a.yml": [[2, "success"]]}, "expect": "unreadable"},
    {"label": "unreadable: variable", "entry": {"requires_var": "WING_COMMANDER_Y"}, "ctx": {"vars_set": {"WING_COMMANDER_Y": "unreadable"}}, "runs": {"a.yml": [[2, "success"]]}, "expect": "unreadable"},
    {"label": "unreadable: signal", "entry": {"signal": {"kind": "release"}}, "signal_days_ago": {"unreadable": "HTTP 502"}, "runs": {"a.yml": [[2, "success"]]}, "expect": "unreadable"},
    {"label": "failing keeps its call-out when the signal is unreadable", "entry": {"signal": {"kind": "release"}}, "signal_days_ago": {"unreadable": "HTTP 502"}, "runs": {"a.yml": [[2, "failure"], [26, "failure"], [50, "failure"]]}, "expect": "failing", "expect_reason": "signal: HTTP 502"},
    {"label": "not running keeps its call-out when the signal is unreadable", "entry": {"signal": {"kind": "release"}}, "signal_days_ago": {"unreadable": "HTTP 502"}, "runs": {"a.yml": []}, "expect": "not running", "expect_reason": "signal: HTTP 502"},
    {"label": "unreadable: scheduled workflow with no cron found", "interval": null, "runs": {"a.yml": [[2, "success"]]}, "expect": "unreadable", "expect_reason": "no cron found"},
    {"label": "unreadable beats paused", "entry": {"kill_switch": "WING_COMMANDER_X_PAUSED"}, "ctx": {"switches": {"WING_COMMANDER_X_PAUSED": true}}, "runs": {"a.yml": {"unreadable": "HTTP 500"}}, "expect": "unreadable"},
    {"label": "worst-of: healthy and failing", "entry": {"workflows": [{"file": "a.yml", "cadence": "schedule"}, {"file": "b.yml", "cadence": "schedule"}]}, "runs": {"a.yml": [[2, "success"]], "b.yml": [[2, "failure"]]}, "expect": "failing"},
    {"label": "idle sibling is ignored", "entry": {"workflows": [{"file": "a.yml", "cadence": "schedule"}, {"file": "b.yml", "cadence": "event"}]}, "runs": {"a.yml": [[2, "success"]], "b.yml": []}, "expect": "healthy"},
    {"label": "all idle is idle", "entry": {"workflows": [{"file": "a.yml", "cadence": "event"}, {"file": "b.yml", "cadence": "event"}]}, "runs": {"a.yml": [], "b.yml": []}, "expect": "idle"},
    {"label": "lifecycle stage rows carry their own state", "entry": {"workflows": [{"file": "a.yml", "cadence": "schedule", "stage": "intake"}, {"file": "b.yml", "cadence": "schedule", "stage": "clarify"}]}, "runs": {"a.yml": [[2, "failure"]], "b.yml": [[2, "success"]]}, "expect": "failing", "expect_stages": {"intake": "failing", "clarify": "healthy"}}
  ]
}
