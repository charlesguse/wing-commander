{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "timeout": 10,
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/constitution-reminder.sh\""
          }
        ]
      }
    ]
  }
}
